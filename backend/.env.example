# Local development. Copy to .env and load it into your shell (README).
DB_USERNAME=my_notes
DB_PASSWORD=replace-with-a-local-password
SPRING_PROFILES_ACTIVE=local
MAIL_ENABLED=true
# local profile defaults: Mailpit localhost:1025, no TLS/auth,
# no-reply@example.test, public origin http://localhost:3000.
# Do not set empty overrides for these local defaults.
GOOGLE_OAUTH_ENABLED=false

# Production: replace the profile and all placeholders, then store values
# in the backend host's environment/secrets, never in the Worker/frontend.
# SPRING_PROFILES_ACTIVE=prod
# APP_PUBLIC_ORIGIN=https://your-public-site.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=no-reply@your-verified-domain.example
# GOOGLE_OAUTH_ENABLED=true
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI is optional: derived from APP_PUBLIC_ORIGIN.
# If set, it must equal APP_PUBLIC_ORIGIN/login/oauth2/code/google.
