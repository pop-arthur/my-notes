# Copy outside Git to /etc/my-notes/production.env; chmod 600.
# Generate DIFFERENT random hex values, e.g. openssl rand -hex 32.
DB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
BACKEND_IMAGE_TAG=vps
# SMTP/Google default to disabled until credentials are configured.
# APP_PUBLIC_ORIGIN is the public Worker URL; Google redirect is derived from it.

# Separate edge secret, also configured as a Wrangler secret; never commit the real value.
EDGE_PROXY_SECRET=REPLACE_WITH_RANDOM_EDGE_SECRET
APP_PUBLIC_ORIGIN=https://my-notes.pop-arthur-c189baa0.workers.dev
MAIL_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
